---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/images/meta/dakeng-og.jpg',
  canonical,
  schema,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://dakengtrails.com');
const canonicalUrl = canonical
  ? new URL(canonical, site)
  : new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Dakeng Trails 大坑步道指南',
  url: site.toString(),
  inLanguage: 'zh-Hant-TW',
  description,
};
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173f35" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="Dakeng Trails 大坑步道指南" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="臺中大坑步道山林與木棧階梯" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema ?? defaultSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <Header path={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
