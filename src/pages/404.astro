---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="找不到頁面｜Dakeng Trails" description="你開啟的頁面不存在，請回到大坑步道指南首頁或14條步道總覽。" noindex>
  <section class="not-found">
    <div class="shell">
      <p class="eyebrow">404 · OFF TRAIL</p>
      <h1>這條路沒有通往頁面</h1>
      <p>回到主路線，重新選擇步道或查看入口地圖。</p>
      <div class="hero-actions"><a class="button" href="/">回到首頁</a><a class="button button-secondary" href="/trails/">查看14條步道</a></div>
    </div>
  </section>
</BaseLayout>
