---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TrailCard from '../components/TrailCard.astro';
import GoogleRating from '../components/GoogleRating.astro';
import Reviews from '../components/Reviews.astro';
import WeatherPanel from '../components/WeatherPanel.astro';
import SeasonalStrategy from '../components/SeasonalStrategy.astro';
import Itinerary from '../components/Itinerary.astro';
import VisitorServices from '../components/VisitorServices.astro';
import HistoryBlock from '../components/HistoryBlock.astro';
import Responsibility from '../components/Responsibility.astro';
import { trails } from '../data/trails';
import { routeGuides } from '../data/content';
import { attraction, googleMapsLinks, attractionGeo, attractionPostalAddress } from '../data/attraction';
import { loadWeather } from '../lib/weather';

const title = `${attraction.fullName}（${attraction.city}）- 14條步道比較・停車・地圖導航`;
const description = `完整收錄 ${attraction.fullName}（${attraction.fullName}）在${attraction.city}${attraction.district}的14條步道：難度比較、入口、停車、大眾運輸與 Google 地圖導航，協助${attraction.fullName}（Dakeng Trails）旅客快速決策。`;

let weatherBundle = null;
try {
  weatherBundle = await loadWeather();
} catch (_) {
  weatherBundle = null;
}

const faqs = [
  ['大坑步道哪一條最簡單？', '9-1號距離短、交通與補給也相對方便；8號同樣適合短程入門。即使是親子級路線，仍有階梯與坡度，請依同行者體力調整。'],
  ['第一次去大坑走哪一條？', '優先考慮9號或9-1號。入口辨識、停車、大眾運輸與周邊補給都比較容易掌握，也能依體力彈性組合。'],
  ['大坑步道需要門票嗎？', '大坑登山步道本身通常不需購票；停車、周邊設施或私人景點可能另有費用，請以現場資訊為準。'],
  ['大坑步道可以帶小孩嗎？', '可以，但應選7、8、9或9-1號等較入門的路線。步道多有階梯，不適合推嬰兒車；幼兒需由成人全程陪同。'],
  ['哪條步道有圓木棧道？', '1至5號一帶較能體驗大坑代表性的圓木路面，其中2、3、4號挑戰感明顯。圓木雨後很滑，不適合毫無經驗者。'],
  ['大坑步道停車方便嗎？', '各入口差異很大。9、9-1號可優先查看經補庫停車場；高地步道周邊空間有限，假日應提早並準備替代方案。'],
  ['沒有開車怎麼去？', '可從臺鐵或捷運松竹站一帶轉乘往大坑方向的公車。9、9-1與10號相對容易安排，班次與停靠請以出發當日資訊為準。'],
  ['下雨後適合走嗎？', '圓木、岩面、落葉與階梯雨後都更滑。若仍有降雨、豪雨後或發布管制，應改期；出發前務必查看通行情形。'],
];

/**
 * 首頁 JSON-LD：完整 TouristAttraction（含 @id、address、geo、hasMap、sameAs）
 * + WebSite + Organization + ItemList + FAQPage。
 * 注意：不包含 aggregateRating 評分，避免冒充官方違反 Google 政策。
 */
const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${attraction.domain ? `https://${attraction.domain}/` : ''}#website`,
    name: 'Dakeng Trails 大坑步道指南',
    url: `https://${attraction.domain}/`,
    description,
    inLanguage: 'zh-Hant-TW',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    '@id': `https://${attraction.domain}/#attraction`,
    name: attraction.fullName,
    alternateName: ['Dakeng Trails', `大坑步道指南`, 'Dakeng Scenic Area'],
    description: `${attraction.fullName}位於${attraction.city}${attraction.district}，共14條步道，從親子散步到圓木挑戰皆有，並整合停車、大眾運輸與 Google 地圖導航。`,
    url: `https://${attraction.domain}/`,
    image: [
      `https://${attraction.domain}/images/trails/dakeng-4.jpg`,
      `https://${attraction.domain}/images/trails/dakeng-2.jpg`,
    ],
    isAccessibleForFree: true,
    address: attractionPostalAddress,
    geo: attractionGeo,
    hasMap: googleMapsLinks.share,
    telephone: attraction.phone,
    sameAs: [googleMapsLinks.share, attraction.officialTourismUrl],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '大坑14條登山步道',
    itemListElement: trails.map((trail, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: trail.name,
      url: `https://${attraction.domain}/trails/${trail.id}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];

const homePageFaqs = faqs.map(([question, answer]) => ({ question, answer }));

const trailImageAlt = `${attraction.fullName} - ${trail => trail} 在 ${attraction.city}`;
---

<BaseLayout title={title} description={description} schema={homeSchema} faqPage={homePageFaqs}>
  <!-- Hero -->
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">TAICHUNG · DAKENG · {attraction.shortName}</p>
        <h1>{attraction.fullName}<br /><em>怎麼選？</em></h1>
        <p>比較臺中 <strong>{attraction.fullName}</strong>（{attraction.shortName}）14 條步道的難度、時間、入口與停車方式，找到適合你的路線，再用 Google Maps 直接導航。</p>
        <GoogleRating rating={attraction.rating} compact />
        <div class="hero-actions">
          <a class="button" href="#trail-finder">
            選擇適合我的步道
            <span aria-hidden="true">↓</span>
          </a>
          <a class="button button-secondary" href="/trails/">查看14條步道</a>
        </div>
        <dl class="hero-stats" aria-label="網站重點">
          <div><dt>步道路線</dt><dd>14<small>條</small></dd></div>
          <div><dt>難度分級</dt><dd>5<small>級</small></dd></div>
          <div><dt>入口導航</dt><dd>1<small>鍵開啟</small></dd></div>
        </dl>
      </div>
      <div class="home-hero-visual">
        <figure class="hero-photo-main">
          <img
            src="/images/trails/dakeng-4.jpg"
            alt={`${attraction.fullName} - Main view in ${attraction.city}, Taiwan`}
            width="1800"
            height="1350"
            fetchpriority="high"
          />
        </figure>
        <figure class="hero-photo-small">
          <img
            src="/images/trails/dakeng-3.jpg"
            alt={`${attraction.fullName} 山林步道與石階 - Hiking near ${attraction.city}`}
            width="1800"
            height="1350"
          />
        </figure>
        <div class="hero-route-note">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 38c3-17 10-26 29-28M28 7l10 3-4 10"/></svg>
          <strong>選對路線</strong>
          <span>從輕鬆散步到圓木挑戰</span>
        </div>
      </div>
    </div>
  </section>

  <!-- H2: Hiking trail finder -->
  <section class="finder-section" id="trail-finder">
    <div class="shell">
      <SectionHeading
        eyebrow="TRAIL FINDER"
        title="用四個問題，找出你的步道"
        text={`不必先研究每一條路線。選擇同行者、時間、體驗與交通方式，我們會從 ${attraction.shortName} 14 條步道中排出更適合的選項。`}
      />

      <form class="trail-finder" data-trail-finder>
        <fieldset>
          <legend><span>01</span> 你和誰一起走？</legend>
          <div class="option-pills">
            <label><input type="radio" name="companion" value="不限" checked /><span>不限</span></label>
            <label><input type="radio" name="companion" value="新手" /><span>一個人／新手</span></label>
            <label><input type="radio" name="companion" value="朋友同行" /><span>情侶朋友</span></label>
            <label><input type="radio" name="companion" value="親子" /><span>帶小孩</span></label>
            <label><input type="radio" name="companion" value="長輩" /><span>帶長輩</span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend><span>02</span> 想走多久？</legend>
          <div class="option-pills">
            <label><input type="radio" name="time" value="999" checked /><span>不限</span></label>
            <label><input type="radio" name="time" value="60" /><span>1小時內</span></label>
            <label><input type="radio" name="time" value="120" /><span>1至2小時</span></label>
            <label><input type="radio" name="time" value="240" /><span>2至4小時</span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend><span>03</span> 想要什麼體驗？</legend>
          <div class="option-pills">
            <label><input type="radio" name="experience" value="不限" checked /><span>不限</span></label>
            <label><input type="radio" name="experience" value="短程" /><span>輕鬆散步</span></label>
            <label><input type="radio" name="experience" value="圓木" /><span>圓木棧道</span></label>
            <label><input type="radio" name="experience" value="城市景觀" /><span>城市景觀</span></label>
            <label><input type="radio" name="experience" value="山林" /><span>山林步道</span></label>
            <label><input type="radio" name="experience" value="挑戰" /><span>挑戰路線</span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend><span>04</span> 如何前往？</legend>
          <div class="option-pills">
            <label><input type="radio" name="transport" value="不限" checked /><span>不限</span></label>
            <label><input type="radio" name="transport" value="parking" /><span>開車</span></label>
            <label><input type="radio" name="transport" value="transit" /><span>大眾運輸</span></label>
          </div>
        </fieldset>
      </form>

      <div class="finder-results-heading">
        <div>
          <p class="eyebrow">RECOMMENDED</p>
          <h3>優先看看這三條</h3>
        </div>
        <p data-finder-summary aria-live="polite">先從入口、交通與難度最容易掌握的路線開始。</p>
      </div>
      <div class="trail-grid finder-results" data-finder-results>
        {trails.map((trail) => (
          <div data-finder-item data-id={trail.id} hidden={!['9', '9-1', '7'].includes(trail.id)}>
            <TrailCard trail={trail} reason={['9', '9-1', '7'].includes(trail.id) ? '第一次到大坑容易上手，時間與交通也較好掌握。' : undefined} />
          </div>
        ))}
      </div>
      <div class="finder-footer">
        <a class="text-link" href="/trails/">瀏覽全部14條步道 <span aria-hidden="true">→</span></a>
        <span>建議仍要依當日通行、天候與同行者狀況調整。</span>
      </div>
    </div>
  </section>

  <!-- H2: First-time visitors -->
  <section class="content-section scenarios-section">
    <div class="shell">
      <SectionHeading eyebrow="FIRST VISIT" title="第一次來，這樣選最快" text={`不從編號開始，而是從你想要的體驗開始。${attraction.shortName} 提供 14 條不同難度的步道，總會找到適合你的一條。`} />
      <div class="scenario-grid">
        <a class="scenario-card scenario-featured" href="/routes/first-time/">
          <img src="/images/trails/dakeng-2.jpg" alt={`${attraction.fullName} 林蔭緩坡階梯 - Easy access trail in ${attraction.city}, Taiwan`} width="1800" height="1349" loading="lazy" />
          <span class="scenario-index">01</span>
          <div>
            <p>第一次到大坑</p>
            <h3>從9號或9-1號開始</h3>
            <span>入口與交通更容易掌握 <i aria-hidden="true">→</i></span>
          </div>
        </a>
        <a class="scenario-card" href="/routes/family/">
          <span class="scenario-index">02</span>
          <div class="scenario-icon" aria-hidden="true">○</div>
          <div><p>親子健走</p><h3>7、8、9號</h3><span>短程、林蔭、可折返 <i aria-hidden="true">→</i></span></div>
        </a>
        <a class="scenario-card" href="/routes/log-stairs/">
          <span class="scenario-index">03</span>
          <div class="scenario-icon" aria-hidden="true">╱╲</div>
          <div><p>經典圓木</p><h3>2、3、4號</h3><span>需要腿力與好鞋底 <i aria-hidden="true">→</i></span></div>
        </a>
        <a class="scenario-card" href="/routes/two-hours/">
          <span class="scenario-index">04</span>
          <div class="scenario-icon" aria-hidden="true">◷</div>
          <div><p>兩小時健行</p><h3>6、9、10號</h3><span>時間明確、彈性折返 <i aria-hidden="true">→</i></span></div>
        </a>
        <a class="scenario-card" href="/routes/challenge/">
          <span class="scenario-index">05</span>
          <div class="scenario-icon" aria-hidden="true">△</div>
          <div><p>山景與挑戰</p><h3>4號與高地路線</h3><span>爬升、稜線、頭嵙山 <i aria-hidden="true">→</i></span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- H2: Comparison preview -->
  <section class="content-section compare-preview">
    <div class="shell compare-preview-grid">
      <div>
        <SectionHeading eyebrow="AT A GLANCE" title="14條步道，差別不只難度" text="距離短不等於輕鬆。圓木間距、連續爬升、遮蔭、入口交通與停車，都會影響實際體驗。" />
        <div class="compare-list">
          <a href="/compare/#easy"><span>最容易入門</span><strong>9-1號</strong><i>短程＋交通方便</i><b>→</b></a>
          <a href="/compare/#family"><span>最適合親子</span><strong>9號</strong><i>補給＋彈性路線</i><b>→</b></a>
          <a href="/compare/#classic"><span>最具代表性</span><strong>2號</strong><i>經典圓木挑戰</i><b>→</b></a>
          <a href="/compare/#challenge"><span>最有挑戰</span><strong>4號</strong><i>爬升＋高地稜線</i><b>→</b></a>
        </div>
        <a class="button button-secondary" href="/compare/">查看完整步道比較</a>
      </div>
      <figure class="compare-photo">
        <img src="/images/trails/dakeng-5.jpg" alt={`${attraction.fullName} 林間木棧道、岩石與原生樹木 - Mountain forest near ${attraction.shortName}`} width="1800" height="1350" loading="lazy" />
        <figcaption><span>路面觀察</span> 木階、岩面與林蔭會直接改變健行節奏。</figcaption>
      </figure>
    </div>
  </section>

  <!-- H2: Map preview -->
  <section class="content-section map-preview">
    <div class="shell">
      <div class="map-heading">
        <SectionHeading eyebrow="MAP & DIRECTIONS" title="入口不同，導航終點也不同" text={`不要只導航「${attraction.fullName}」。先確認要走的步道，再開啟具體入口或停車場導航。`} />
        <a class="button button-secondary" href="/map/">查看入口地圖</a>
      </div>
      <div class="map-frame-wrap">
        <iframe
          title={`${attraction.fullName} Google 地圖`}
          src={googleMapsLinks.embed}
          width="1180"
          height="520"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <div class="map-callout">
          <span aria-hidden="true">⌖</span>
          <div><strong>先選步道，再開導航</strong><small>每條步道的登山口、停車與下車點都可能不同。</small></div>
          <a href="/map/">開啟地點清單 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- H2: Route preview -->
  <section class="content-section route-preview">
    <div class="shell">
      <SectionHeading eyebrow="SUGGESTED PLANS" title="不是只走一條步道，而是安排一段好行程" text="把交通、健行、休息與周邊用餐放在同一條時間線上，更容易抓準出發與回程。" />
      <div class="route-card-grid">
        {routeGuides.slice(0, 3).map((route, index) => (
          <a class="route-card" href={`/routes/${route.slug}/`}>
            <span class="route-card-number">0{index + 1}</span>
            <p>{route.kicker}</p>
            <h3>{route.title}</h3>
            <div class="route-line" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <p>{route.description}</p>
            <span class="route-meta">約 {route.minutes / 60} 小時 · {route.trails.map((id) => `${id}號`).join('、')}</span>
          </a>
        ))}
      </div>
      <div class="section-footer-link"><a class="text-link" href="/routes/">查看全部情境路線 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <!-- H2: Preparation -->
  <section class="content-section prep-preview">
    <div class="shell prep-grid">
      <div>
        <SectionHeading eyebrow="BEFORE YOU GO" title="出發前，先把四件事準備好" text={`${attraction.shortName} 是城市近郊步道，但圓木、陡坡、濕滑與高溫仍需要認真準備。`} />
        <a class="text-link" href="/guides/what-to-bring/">查看完整行前清單 <span aria-hidden="true">→</span></a>
      </div>
      <div class="prep-list">
        <a href="/guides/what-to-bring/"><span>01</span><div><strong>防滑鞋與飲水</strong><small>不要用平底休閒鞋挑戰圓木陡坡</small></div><i>→</i></a>
        <a href="/guides/rainy-day/"><span>02</span><div><strong>雨後路況判斷</strong><small>圓木、岩面與落葉會更滑</small></div><i>→</i></a>
        <a href="/guides/summer-hiking/"><span>03</span><div><strong>避開正午高溫</strong><small>提早出發並設定折返時間</small></div><i>→</i></a>
        <a href="https://www.scenic.taichung.gov.tw/833821/833844/833845/3040068" target="_blank" rel="noopener"><span>04</span><div><strong>確認步道通行</strong><small>施工與天候可能造成臨時管制</small></div><i>↗</i></a>
      </div>
    </div>
  </section>

  <!-- H2: 即時氣象（從伺服器端拉取、30 分鐘快取；前端無 API 字樣） -->
  <section class="content-section weather-section">
    <div class="shell">
      <SectionHeading eyebrow="NOW · NEXT 7 DAYS" title="出門前最在意的兩件事：會不會下雨、體感幾度" text="即時溫度、體感與七日預報的整合面板；協助評估要帶傘、防曬，或延後出發。" />
      <WeatherPanel bundle={weatherBundle} showHeader={false} />
      <div class="section-footer-link"><a class="text-link" href="/weather/">查看完整氣象與預報 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <!-- H2: 四季遊覽策略摘要 -->
  <section class="content-section alt seasons-preview">
    <div class="shell">
      <SeasonalStrategy showHeading={true} heading="四季遊覽策略摘要" eyebrow="SEASONAL PLAYBOOK" />
      <div class="section-footer-link"><a class="text-link" href="/seasons/">查看完整四季策略 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <!-- H2: 行程節奏摘要 -->
  <section class="content-section itinerary-preview">
    <div class="shell">
      <Itinerary showHeading={true} heading="行程節奏：半日 / 全日 / 三類按對象" eyebrow="ITINERARIES" />
      <div class="section-footer-link"><a class="text-link" href="/itinerary/">查看完整行程模板 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <!-- H2: 設施類型指南（中立） -->
  <section class="content-section alt facilities-preview">
    <div class="shell">
      <VisitorServices showHeading={true} heading="週邊設施類型指南（中立客觀）" eyebrow="FACILITIES" />
      <div class="section-footer-link"><a class="text-link" href="/facilities/">查看完整設施與檢核表 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <!-- H2: 歷史、故事與地名由來 -->
  <section class="content-section history-preview">
    <div class="shell">
      <HistoryBlock showHeading={true} heading="歷史、故事與地名由來" eyebrow="HISTORY · LEGENDS" showLegends={true} showGeology={true} />
      <div class="section-footer-link"><a class="text-link" href="/history/">查看完整歷史與傳說 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <!-- H2: 訪客責任與 LNT -->
  <section class="content-section alt responsibility-preview">
    <div class="shell">
      <Responsibility showHeading={true} heading="訪客責任與入山 SOP" eyebrow="RESPONSIBILITY · ETIQUETTE" />
    </div>
  </section>

  <!-- H2: FAQ preview (page only, JSON-LD already in head) -->
  <section class="content-section alt">
    <div class="shell">
      <SectionHeading eyebrow="FAQ" title="第一次規劃大坑，常遇到的問題" />
      <div class="faq-list home-faq">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <div>{answer}</div>
          </details>
        ))}
      </div>
      <div class="section-footer-link"><a class="text-link" href="/faq/">更多常見問題 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <!-- H2: Google Maps reviews - 顯示評分與精選評價（不入 JSON-LD） -->
  <Reviews
    title="Google 地圖使用者評價精選"
    description={`以下評分與精選內容同步自 Google 地圖公開評價，僅作為本站內容輔助。最即時的評論、照片與最新評分請以 ${attraction.fullName} Google 地圖頁面為準。`}
  />

  <!-- H2: Final CTA -->
  <section class="content-section final-cta">
    <div class="shell cta-panel">
      <div>
        <p class="eyebrow">READY TO GO?</p>
        <h2>選好步道，就從正確入口出發。</h2>
        <p>先比較難度與時間，再確認停車、交通和當日通行情形。</p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href="/trails/">瀏覽14條步道</a>
        <a class="button button-secondary button-on-dark" href="/map/">開啟地圖導航</a>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-trail-finder]');
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-finder-item]'));
    const summary = document.querySelector<HTMLElement>('[data-finder-summary]');

    const updateRecommendations = () => {
      if (!form) return;
      const values = new FormData(form);
      const companion = String(values.get('companion') ?? '不限');
      const time = Number(values.get('time') ?? 999);
      const experience = String(values.get('experience') ?? '不限');
      const transport = String(values.get('transport') ?? '不限');

      const ranked = items.map((item) => {
        const card = item.querySelector<HTMLElement>('[data-trail-card]');
        if (!card) return { item, score: -999 };
        let score = 0;
        const suitable = card.dataset.suitable ?? '';
        const features = card.dataset.features ?? '';
        const difficulty = card.dataset.difficulty ?? '';
        const maxDuration = Number(card.dataset.duration ?? 999);
        const family = Number(card.dataset.family ?? 0);
        const transit = Number(card.dataset.transit ?? 0);
        const parking = Number(card.dataset.parking ?? 0);

        if (companion !== '不限') {
          if (suitable.includes(companion)) score += 5;
          if (companion === '長輩' && (difficulty === '親子' || difficulty === '入門')) score += 4;
          if (companion === '新手' && (difficulty === '親子' || difficulty === '入門')) score += 4;
          if (companion === '親子') score += family;
        }
        if (maxDuration <= time) score += 4;
        else score -= Math.ceil((maxDuration - time) / 30);
        if (experience !== '不限') {
          if (experience === '圓木' && (features.includes('圓木') || (card.textContent ?? '').includes('圓木'))) score += 6;
          else if (experience === '挑戰' && (difficulty === '進階' || difficulty === '挑戰')) score += 6;
          else if (features.includes(experience)) score += 6;
        }
        if (transport === 'transit') score += transit * 1.5;
        if (transport === 'parking') score += parking * 1.5;
        if (companion === '不限' && experience === '不限' && transport === '不限') {
          if (['9', '9-1', '7'].includes(item.dataset.id ?? '')) score += 8;
        }
        return { item, score };
      }).sort((a, b) => b.score - a.score);

      items.forEach((item) => { item.hidden = true; });
      ranked.slice(0, 3).forEach(({ item }) => { item.hidden = false; });
      if (summary) {
        const labels = ranked.slice(0, 3).map(({ item }) => `${item.dataset.id}號`).join('、');
        summary.textContent = `依目前條件，建議先比較 ${labels}。`;
      }
    };

    form?.addEventListener('change', updateRecommendations);
  </script>
</BaseLayout>
