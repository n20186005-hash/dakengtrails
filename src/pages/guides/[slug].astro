---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TrailCard from '../../components/TrailCard.astro';
import { guides } from '../../data/content';
import { trails } from '../../data/trails';
export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const guideContent: Record<string, { lead: string; sections: [string, string][]; picks: string[] }> = {
  'jingbuku-parking': {
    lead: '經補庫停車場是走大坑9號、9-1號步道常用的起點，不等於所有大坑步道的共用入口。先確定步道編號，再從停車場步行前往正確入口。',
    sections: [
      ['經補庫停車場在哪裡？', '臺中市政府環保局公開資料列地址為「臺中市北屯區東山路一段378-17號」、座標約24.176720、120.732369。<a href="https://www.google.com/maps/search/?api=1&query=%E5%A4%A7%E5%9D%91%E7%B6%93%E8%A3%9C%E5%BA%AB%E5%81%9C%E8%BB%8A%E5%A0%B4" target="_blank" rel="noopener">開啟經補庫停車場專屬地點 ↗</a>。'],
      ['停車場開放與收費', '環保局充電站資料標示24小時，但這不等於保證全天有停車位，也不代表即時收費政策；停車規則、車格及充電設備請依現場標示確認。<a href="https://green.epb.taichung.gov.tw/page/stronghold/p03.aspx?city=160&num=2655&pro_kind=2" target="_blank" rel="noopener">查看市府位置資料 ↗</a>。'],
      ['走9號步道怎麼走？', '由停車場周邊辨識經補路方向，往經補路一段383巷與九九橋方向依指標接近登山口。請勿把停車場入口當成登山步道口；<a href="/trails/9/#entrance">查看9號專頁入口與導航</a>。'],
      ['走9-1號步道怎麼走？', '9-1號入口同樣在經補路一段383巷一帶；出發前可從大坑地震公園旁轉入經補路，依現場路標分辨9與9-1號方向。<a href="/trails/9-1/#entrance">查看9-1號路線</a>。'],
      ['搭公車可以抵達嗎？', '臺中市風景區管理所指出「大坑9號步道站」位在東山路與松竹路交叉口附近的經補庫停車場前。班次及路線可能變動，請以當日公車動態為準；<a href="/transport/">大眾運輸安排</a>。'],
      ['假日沒有車位怎麼辦？', '可查詢大坑地震公園周邊合法車位，或改搭大眾運輸。不把經補庫當作7、8號步道的最近停車場；兩條路線應優先研究6號停車場與建成巷動線。'],
      ['官方資料', '<a href="https://travel.taichung.gov.tw/zh-tw/experience/hikingtrail/10" target="_blank" rel="noopener">臺中觀光旅遊網9號步道</a>、<a href="https://taichung.travel/zh-tw/experience/hikingtrail/11" target="_blank" rel="noopener">9-1號步道</a>、<a href="https://www.scenic.taichung.gov.tw/863699/post" target="_blank" rel="noopener">風景區管理所交通資訊</a>。資料核對：2026-11-17；動態資訊仍以現場為準。'],
    ], picks: ['9', '9-1', '10'],
  },
  'trail-7-parking': {
    lead: '7號步道不是從經補庫停車場直接起登。臺中觀光旅遊網指出，多數遊客先到6號步道停車場，再由建成巷一帶找到7號登山口。',
    sections: [
      ['7號步道停哪裡？', '建議先查「大坑6號步道停車場」的合法停車空間，再確認7號步道入口。<a href="https://www.google.com/maps/search/?api=1&query=%E5%A4%A7%E5%9D%916%E8%99%9F%E6%AD%A5%E9%81%93%E5%81%9C%E8%BB%8A%E5%A0%B4" target="_blank" rel="noopener">開啟6號停車場地點 ↗</a>。車位是否開放以現場公告為準。'],
      ['登山口從哪裡進？', '官方路線起點為北屯區建成巷，7號入口在6號步道停車場前方道路附近。步行時依7號步道標誌，不要直接導航到風動石公園當作起點。<a href="https://www.google.com/maps/search/?api=1&query=%E5%A4%A7%E5%9D%917%E8%99%9F%E7%99%BB%E5%B1%B1%E6%AD%A5%E9%81%93%E7%99%BB%E5%B1%B1%E5%8F%A3" target="_blank" rel="noopener">開啟7號登山口搜尋 ↗</a>。'],
      ['走多久、難度如何？', '臺中觀光旅遊網列7號為親子級，路線長約1.3公里、運動時間約1小時，海拔約227–373公尺。這是官方單線資料；往返、拍照與停車步行時間應另外估算。'],
      ['路線怎麼走？', '建成巷入口出發，沿較平緩的產業道路、農機道及部分枕木段往風動石公園。到達後可原路折返，或先確認6號步道開放狀態再規劃下山。'],
      ['假日開車注意', '山區產業道路狹窄，部分路段有交通管制或單行安排，不要為了靠近觀音亭而駛入不熟悉的農路；避免擋住居民與農務動線。'],
      ['官方來源與路況', '<a href="https://travel.taichung.gov.tw/zh-tw/experience/hikingtrail/8" target="_blank" rel="noopener">臺中觀光旅遊網7號步道</a>。內容核對：2026-11-17；<a href="https://www.scenic.taichung.gov.tw/833821/833844/833845/3040068" target="_blank" rel="noopener">出發當日查看開放公告 ↗</a>。'],
    ], picks: ['7', '6', '8'],
  },
  'trail-8-parking': {
    lead: '8號步道與7號同屬建成巷、風動石公園周邊的健行路網。找車位時先確認6號停車場，預留走到8號登山口的接駁步行時間。',
    sections: [
      ['8號步道停車場在哪？', '臺中市政府觀旅局建議開車遊客使用6號步道停車場，再沿建成巷步行到8號登山口。<a href="https://www.google.com/maps/search/?api=1&query=%E5%A4%A7%E5%9D%916%E8%99%9F%E6%AD%A5%E9%81%93%E5%81%9C%E8%BB%8A%E5%A0%B4" target="_blank" rel="noopener">6號停車場 Google Maps ↗</a>。'],
      ['停車後要走多久到入口？', '市府2022年路線介紹曾建議沿建成巷步行約15分鐘抵達8號登山口；這是舊公告提供的參考時間，不保證目前路況及每個停車格的實際步行時間。'],
      ['8號登山口怎麼導航？', '入口在建成巷周邊的產業道路支線，先找8號步道標誌，再核對是否進入正確路線。<a href="https://www.google.com/maps/search/?api=1&query=%E5%A4%A7%E5%9D%918%E8%99%9F%E7%99%BB%E5%B1%B1%E6%AD%A5%E9%81%93%E7%99%BB%E5%B1%B1%E5%8F%A3" target="_blank" rel="noopener">開啟8號登山口搜尋 ↗</a>。'],
      ['沿途有哪些特色？', '官方介紹8號沿途有產業道路、鐵木步道和相思枕木棧道三種路面型態，終點連接風動石公園。雨後木面濕滑，親子同行也需要放慢下坡速度。'],
      ['能走6、7、8號環線嗎？', '可在風動石公園視現場開放狀態選擇6號或7號回到停車場，但環線時間不能只取8號單走估計；先核對回程入口與停車位置。'],
      ['官方來源與路況', '<a href="https://travel.taichung.gov.tw/zh-tw/event/newsdetail/7415" target="_blank" rel="noopener">臺中市政府8號步道親子路線介紹</a>。內容核對：2026-11-17；出發前請檢查<a href="https://www.scenic.taichung.gov.tw/833821/833844/833845/3040068" target="_blank" rel="noopener">當日通行資訊 ↗</a>。'],
    ], picks: ['8', '7', '6'],
  },
  'trail-route-map': {
    lead: '大坑共有不同入口、停車區與串走路線；地圖不只是看山徑線條，更要找到起登點、下山方向和停車位置。本站整理14條步道的個別導航與常見組合。',
    sections: [
      ['哪裡看官方大坑步道路線圖？', '臺中觀光旅遊網提供含登山口、停車場、涼亭與洗手間的<a href="https://travel.taichung.gov.tw/file/1599/" target="_blank" rel="noopener">官方登山健行導覽圖 ↗</a>。可先閱讀圖例，再到本站<a href="/map/">14條步道入口清單</a>分別開啟 Google Maps。'],
      ['6、7、8號怎麼串走？', '這一組主要經建成巷及6號停車場周邊起登，風動石公園是常見銜接點。可單走7或8號，也可查明6號通行狀態後規劃環線；車子最好停在預計回程可抵達的位置。'],
      ['9、9-1、10號在哪一區？', '這一組主要從經補路一帶出發，經補庫停車場是重要停車與公車轉乘地標。各線入口仍有差異，不能把停車場位置複製成三條步道的同一個登山口。'],
      ['1至5號可以照圖直接串嗎？', '高地與圓木路線對腿力及回程判斷要求較高。先確認步道有無封閉、岔路和爬升，避免只根據地圖上的相鄰線段推估時間。'],
      ['Google Maps 是實際登山軌跡嗎？', '本站地圖連結是位置搜尋或道路導航，不代表可離線使用的正式登山軌跡。山區以官方導覽圖、現場指標和通行公告為主，不要把汽車導航延伸到步道上。'],
      ['如何安排完整時間？', '把停車與步行到入口、登山、休息、回程和下山後取車都算進行程。先用<a href="/compare/">14條步道難度與時間表</a>縮小選擇，再看<a href="/parking/">停車攻略</a>。'],
      ['核對來源', '<a href="https://travel.taichung.gov.tw/file/1599/" target="_blank" rel="noopener">臺中官方步道導覽圖</a>及各條官方步道資料；內容核對：2026-11-17。若施工更動，請依最新管理所公告。'],
    ], picks: ['7', '8', '9'],
  },
  'trail-difficulty': {
    lead: '大坑步道不能只用公里數判斷難易。圓木間距、連續爬升、路面濕滑與回程下坡，往往比距離更影響體力。',
    sections: [
      ['親子、入門與中等怎麼分？', '先看9號、9-1號等相對容易安排的路線，再比較7、8、10號的坡度與時間。本站分級是行程規劃參考，不是官方安全認證；同一條路也會因天候與體力而有不同感受。'],
      ['進階、挑戰路線難在哪？', '1至4號部分路線有圓木、陡坡或連續爬升，5號及高地串走也需要較完整的回程規劃。即使單段距離短，也不能把它當作平地散步。'],
      ['時間、距離與高差如何一起看？', '先到步道比較表查看各線建議分鐘數、距離、海拔範圍，再核對路線是往返還是可串連。若連走兩條以上，不能只採計單段標示時間。'],
      ['第一次去大坑怎麼挑？', '以交通方便、容易掌握折返點的9號或9-1號為起點；若希望更有運動量，再評估7、8或10號。無論選哪條，都需預留休息、拍照和回程時間。'],
      ['雨後與親子同行要調整嗎？', '雨後木面、石面及落葉容易滑；帶孩子要留意下坡膝踝負擔與能否提前折返。官方如公告封閉，任何難度分級都不能取代管制。'],
      ['出發前最後核對', '先查看<a href="/compare/">14條步道難度比較</a>、<a href="/parking/">停車攻略</a>與<a href="/map/">入口地圖</a>，再開啟各條步道自己的 Google Maps 導航。'],
    ], picks: ['9-1', '7', '4'],
  },
  'trail-10-duration': {
    lead: '搜尋「大坑10號步道要走多久」，最重要的是區分單走10號與串連其他步道。先用本站的建議區間估算，再加上交通、休息與折返緩衝。',
    sections: [
      ['10號步道要預留多少時間？', '本站建議單走約50–90分鐘，步道資料列為約1.2公里、入門級，屬健行規劃估計而非保證抵達時間。登山口交通、拍照、停留、山徑狀況及隊伍速度要另留緩衝；可核對<a href="/trails/10/">10號步道基本資料</a>。'],
      ['從哪裡開始走？', '先選定要使用的登山口，導航到<a href="/trails/10/#entrance">10號步道入口說明</a>，不要只輸入「大坑風景區」。抵達後看現場路標，確認目前開放的路段與折返方向。'],
      ['10號步道難不難？', '實際難度需要一起看坡度、階梯與路面，不只看距離。可先讀<a href="/trails/10/">10號步道難度與路面</a>，再與<a href="/compare/">其他13條步道</a>對照。'],
      ['停車與公車時間要另計嗎？', '要。找車位、從停車位置走到登山口，以及等車都不包含在單走估計內。開車先看<a href="/parking/">停車場與入口</a>，搭車請看<a href="/transport/">大眾運輸指南</a>。'],
      ['能與9號、9-1號一起走嗎？', '可以依當天開放路段與步道銜接規劃，但串連不能只套用10號的單段時間。第一次造訪、親子或午後才出發時，建議先選一條，確保回程不摸黑。'],
      ['怎麼設定折返時間？', '先決定必須回到登山口的時間，再扣掉回程、休息及意外延誤的緩衝。若遇降雨、體力下降或路線標示不清，立刻縮短而非追加路程。'],
    ], picks: ['10', '9', '9-1'],
  },
  'what-to-bring': {
    lead: '大坑是城市近郊山區，裝備不用複雜，但鞋子、飲水、通行資訊與折返時間不能省略。',
    sections: [
      ['鞋子怎麼選？', '選有明顯鞋紋、包覆穩定的運動鞋或登山鞋。要走圓木與陡坡時，平底休閒鞋的抓地力不足。'],
      ['水與食物帶多少？', '依天氣、時間與個人流汗量準備飲水。短程也要帶水；高溫時可補充電解質，但不要依賴步道上一定有補給。'],
      ['手機要準備什麼？', '先開啟入口、停車與回程站牌，截圖關鍵資訊。山區訊號不穩時，仍能查看事先保存的內容。'],
      ['怎麼設定折返時間？', '用預計回到入口的時間往回推，保留至少三分之一體力下山。天色、天候或同行者狀況變差就提前回程。'],
    ], picks: ['9', '7', '6'],
  },
  'rainy-day': {
    lead: '雨後不是只有泥濘問題；圓木、岩面、落葉與階梯邊緣都會降低摩擦，能見度與山區道路也可能受影響。',
    sections: [
      ['什麼情況應該改期？', '仍在降雨、豪雨後、官方發布管制，或同行者沒有防滑鞋與雨天經驗時，改期是更合理的選擇。'],
      ['圓木為什麼特別滑？', '圓木表面濕潤後抓地力快速下降，不規則間距也讓落腳更難；下坡時風險通常比上坡高。'],
      ['如果只是短暫小雨？', '先查看雷達、通行情形與現場告示。即使選入門步道，也不要在雷雨或強風預警下進入。'],
      ['有哪些替代安排？', '可改為大坑商圈用餐、安排室內景點，或把行程換到天候穩定的日期，不需要為了既定計畫勉強上山。'],
    ], picks: ['9-1', '8', '9'],
  },
  'summer-hiking': {
    lead: '夏季大坑悶熱且部分路段曝曬，提早出發、縮短路線與主動補水，比追求走完全程更重要。',
    sections: [
      ['幾點出發比較合適？', '盡量避開接近正午的高溫時段，並依日落時間設定最晚折返。'],
      ['怎麼避免熱不適？', '少量多次補水、穿透氣衣物、在陰影處休息。頭暈、噁心、異常疲憊時要立即停止前進。'],
      ['哪種路線比較合適？', '選林蔭較多、時間可控且容易折返的路線，例如7、8或9號，再依現場溫度縮短。'],
      ['防曬與防蚊怎麼做？', '帽子、袖套或透氣長袖能減少曝曬；防蚊用品依說明使用，流汗後視需要補擦。'],
    ], picks: ['8', '7', '9'],
  },
  'log-stairs-safety': {
    lead: '大坑圓木步道的特色也正是難點：表面圓、間距不一、下坡衝擊明顯，雨後更需要保守。',
    sections: [
      ['落腳點怎麼選？', '腳掌盡量踩在圓木中央或穩定位置，避免跨太大步；保持三點平衡，不急著跟上前方速度。'],
      ['下坡重心怎麼控制？', '縮短步幅、降低速度，重心保持在腳掌上方。若有扶手或繩索，先確認穩固再輔助。'],
      ['登山杖一定需要嗎？', '不是每個人都需要，但會使用者可用來分擔下坡衝擊。第一次使用不要直接拿去走最陡圓木段。'],
      ['誰不適合直接挑戰？', '膝踝不穩、懼高、平衡感差或完全沒有山徑經驗者，建議先走9號等入門路線。'],
    ], picks: ['2', '3', '4'],
  },
  'hiking-with-children': {
    lead: '判斷孩子能不能走，不只看年齡；平時活動量、階梯能力、是否願意折返與成人照顧比例更重要。',
    sections: [
      ['第一次帶孩子選哪條？', '優先看9-1、8、7或9號。先選容易折返的短線，完成後再決定下次是否增加距離。'],
      ['可以推嬰兒車嗎？', '多數大坑步道有階梯、坡度或不平路面，不適合推嬰兒車。'],
      ['需要準備哪些東西？', '孩子自己的飲水、簡單食物、帽子、防蚊、防曬與備用衣物；成人也要保留體力協助。'],
      ['什麼時候該折返？', '孩子開始拖步、注意力下降、抱怨頭暈或天候變差時就折返，不以抵達某個點為必要目標。'],
    ], picks: ['9-1', '8', '7'],
  },
};
const content = guideContent[guide.slug];
const selected = content.picks.map((id) => trails.find((trail) => trail.id === id)).filter(Boolean);
const title = `${guide.title}｜大坑步道指南`;
const description = guide.description;
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: guide.title,
  description, inLanguage: 'zh-Hant-TW', image: 'https://dakengtrails.com/images/trails/dakeng-5.jpg',
  mainEntityOfPage: `https://dakengtrails.com/guides/${guide.slug}/`,
};
---
<BaseLayout title={title} description={description} schema={articleSchema}>
  <Breadcrumbs items={[{ label: '行前準備', href: '/guides/' }, { label: guide.title }]} />
  <section class="article-hero">
    <div class="shell article-hero-grid">
      <div><p class="eyebrow">TRAIL GUIDE</p><h1>{guide.title}</h1><p>{content.lead}</p></div>
      <figure><img src="/images/trails/dakeng-5.jpg" alt="大坑山林岩面與木棧步道" width="1800" height="1350" fetchpriority="high" /></figure>
    </div>
  </section>
  <section class="content-section">
    <article class="shell prose article-prose">
      <div class="callout">先查看當日天候與步道通行情形；任何指南都不能取代現場管制與個人身體狀況判斷。</div>
      {content.sections.map(([heading, text]) => <section><h2>{heading}</h2><p set:html={text} /></section>)}
    </article>
  </section>
  <section class="content-section alt">
    <div class="shell">
      <SectionHeading eyebrow="RELATED TRAILS" title="搭配這幾條步道看" />
      <div class="trail-grid">{selected.map((trail) => trail && <TrailCard trail={trail} />)}</div>
    </div>
  </section>
</BaseLayout>
