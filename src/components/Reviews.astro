---
/**
 * 精選評價區塊：顯示從 Google 地圖使用者評價中挑選的精選摘要。
 * 注意：這些內容僅作為頁面視覺顯示，明確標明來源與同步時間，
 * 不寫入 Schema.org/JSON-LD，以避免冒充官方評分並遵守 Google Maps 平台政策。
 */
import { featuredReviews, reviewsAttribution } from '../data/reviews';
import { attraction, googleMapsLinks } from '../data/attraction';

interface Props {
  /** 章節標題，預設採用「Google 地圖使用者評價」 */
  title?: string;
  /** 章節說明文字 */
  description?: string;
  /** 顯示於評價區塊下的「查看全部評價」按鈕文字 */
  viewAllLabel?: string;
  /** 額外 className */
  className?: string;
}

const {
  title = 'Google 地圖使用者評價精選',
  description = '以下內容摘自 Google 地圖使用者公開評價，僅作為本站內容輔助；同步時間、版權與最新內容以 Google 地圖為準。',
  viewAllLabel = '在谷歌地圖查看全部評價',
  className = '',
} = Astro.props;

const reviewCountLabel = attraction.rating.reviewCount.toLocaleString('en-US');
---

<section class:list={["reviews-block", className]} aria-label={title}>
  <header class="reviews-block-head">
    <p class="eyebrow">GOOGLE MAPS · REVIEWS</p>
    <h2>{title}</h2>
    <p class="reviews-block-lead">{description}</p>
  </header>
  <ul class="reviews-list">
    {featuredReviews.map((review) => (
      <li class="review-card">
        <div class="review-card-head">
          <div class="review-card-author">
            <span class="review-card-avatar" aria-hidden="true">
              {review.author.slice(0, 1)}
            </span>
            <div>
              <strong>{review.author}</strong>
              <small>{review.relativeTime} · Google 地圖</small>
            </div>
          </div>
          <div class="review-card-stars" aria-label={`${review.rating} 顆星`}>
            {'★'.repeat(review.rating)}
            <span class="review-card-stars-empty" aria-hidden="true">{'☆'.repeat(5 - review.rating)}</span>
          </div>
        </div>
        <p class="review-card-text">{review.text}</p>
      </li>
    ))}
  </ul>
  <footer class="reviews-block-foot">
    <p class="reviews-block-attribution">{reviewsAttribution.detailed} · 同步時間 {attraction.rating.syncedAt}。</p>
    <a
      class="button"
      href={googleMapsLinks.allReviews}
      target="_blank"
      rel="noopener noreferrer nofollow"
    >
      {viewAllLabel}
      <span aria-hidden="true">↗</span>
    </a>
  </footer>
  <p class="reviews-block-note">共 {reviewCountLabel} 則使用者評價 · 本頁僅節錄部分內容用於參考</p>
</section>

<style>
  .reviews-block {
    padding: 80px 0;
    background: var(--cream, #fcfaf5);
  }
  .reviews-block-head {
    max-width: 760px;
    margin: 0 auto 36px;
  }
  .reviews-block-head h2 {
    margin: 0;
    color: var(--forest, #173f35);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    font-weight: 500;
    line-height: 1.1;
  }
  .reviews-block-lead {
    margin: 14px 0 0;
    color: var(--muted, #65706b);
    line-height: 1.75;
  }
  .reviews-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px;
    list-style: none;
  }
  .review-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border: 1px solid rgba(23, 63, 53, 0.12);
    border-radius: 18px;
    background: var(--cream, #fcfaf5);
  }
  .review-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .review-card-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .review-card-avatar {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--forest, #173f35);
    color: #fff;
    font-family: Georgia, serif;
    font-weight: 700;
  }
  .review-card-author strong {
    display: block;
    color: var(--forest, #173f35);
    font-size: 0.95rem;
  }
  .review-card-author small {
    display: block;
    margin-top: 2px;
    color: var(--muted, #65706b);
    font-size: 0.74rem;
  }
  .review-card-stars {
    color: #e8ae4f;
    font-size: 1rem;
    letter-spacing: 2px;
  }
  .review-card-stars-empty {
    color: #d7d5cb;
  }
  .review-card-text {
    margin: 0;
    color: #394841;
    font-size: 0.94rem;
    line-height: 1.75;
  }
  .reviews-block-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    max-width: 1180px;
    margin: 32px auto 0;
    padding: 0 20px;
  }
  .reviews-block-attribution {
    margin: 0;
    color: var(--muted, #65706b);
    font-size: 0.84rem;
    line-height: 1.7;
    max-width: 720px;
  }
  .reviews-block-note {
    max-width: 1180px;
    margin: 18px auto 0;
    padding: 0 20px;
    color: var(--muted, #65706b);
    font-size: 0.78rem;
  }

  @media (max-width: 980px) {
    .reviews-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 660px) {
    .reviews-block { padding: 60px 0; }
    .reviews-list { grid-template-columns: 1fr; }
    .reviews-block-foot { flex-direction: column; align-items: flex-start; }
  }
</style>
