---
/**
 * 季度遊覽策略區塊
 * - 氣象：基於中央氣象署之常年氣候均態為主，並提醒當日實況優先
 * - 建議路線：用類型與節奏描述，不推薦具體商家
 */
import { seasons, type SeasonKey } from '../data/seasonal';

interface Props {
  show?: SeasonKey[];
  showHeading?: boolean;
  heading?: string;
  eyebrow?: string;
}

const {
  show,
  showHeading = true,
  heading = '四季遊覽策略',
  eyebrow = 'SEASONAL PLAYBOOK',
} = Astro.props;

const seasonOrder: SeasonKey[] = ['spring', 'summer', 'autumn', 'winter'];
const data = (show && show.length > 0
  ? seasonOrder.filter((key) => show.includes(key))
  : seasonOrder
).map((key) => seasons.find((s) => s.key === key)).filter((s): s is NonNullable<typeof s> => Boolean(s));
---

{showHeading && (
  <header class="seasons-head">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{heading}</h2>
    <p>以下數據以中央氣象署（CWB）之常年均態與在地實務經驗為基礎，提供半日的拍攝／健行策略。出發前請仍以當日預報為主。</p>
  </header>
)}

<div class="seasons-table-wrap">
  <table class="seasons-table">
    <thead>
      <tr>
        <th>季度</th>
        <th>氣象重點</th>
        <th>建議路線</th>
        <th>注意事項</th>
        <th>裝備建議</th>
      </tr>
    </thead>
    <tbody>
      {data.map((season) => (
        <tr>
          <th scope="row">
            <span class="seasons-season-label">{season.label}</span>
            <small>{season.months}</small>
          </th>
          <td>
            <dl class="seasons-fact-list">
              <div><dt>均溫高／低</dt><dd>{season.cwbNormal.avgHighC}° / {season.cwbNormal.avgLowC}°</dd></div>
              <div><dt>降雨日數</dt><dd>約 {season.cwbNormal.rainyDays} 日／月</dd></div>
              <div><dt>重點</dt><dd>{season.cwbNormal.rainyNote}</dd></div>
              <div><dt>人潮</dt><dd>{season.cwbNormal.visitorsNote}</dd></div>
            </dl>
          </td>
          <td>
            <ul>
              {season.bestFor.map((item) => <li>{item}</li>)}
            </ul>
          </td>
          <td>
            <ul class="seasons-risks">
              {season.risks.map((risk) => (
                <li>
                  <strong>{risk.title}</strong>
                  <span>{risk.detail}</span>
                </li>
              ))}
            </ul>
          </td>
          <td>
            <ul class="seasons-suggested">
              {season.suggested.map((s) => (
                <li>
                  <strong>{s.theme}</strong>
                  <span>{s.detail}</span>
                </li>
              ))}
              <li class="seasons-foot-item">
                <strong>出門前提</strong>
                <span>{season.visitorPointers[0]}</span>
              </li>
            </ul>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<div class="seasons-note">
  <p>※本表整理自中央氣象署公開資料中的長年均態與在地經驗，僅供參考；行程前建議對照<a href="https://www.cwb.gov.tw" target="_blank" rel="noopener noreferrer">中央氣象署最新預報</a>與<a href="https://www.scenic.taichung.gov.tw/833821/833844/833845/3040068" target="_blank" rel="noopener noreferrer">步道通行情形</a>。</p>
</div>

<style>
  .seasons-head { max-width: 880px; margin: 0 auto 36px; }
  .seasons-head h2 { font-family: Georgia, serif; color: var(--forest, #173f35); font-size: clamp(1.7rem, 3vw, 2.4rem); margin: 12px 0 14px; line-height: 1.2; }
  .seasons-head p { color: var(--muted, #65706b); line-height: 1.85; }

  .seasons-table-wrap { overflow-x: auto; border-radius: 18px; box-shadow: 0 20px 48px -28px rgba(23,63,53,.4); background: #fcfaf5; }
  .seasons-table { width: 100%; border-collapse: collapse; min-width: 920px; }
  .seasons-table th, .seasons-table td { vertical-align: top; padding: 18px 18px; border-bottom: 1px solid rgba(23,63,53,.1); }
  .seasons-table thead th { background: var(--forest, #173f35); color: #fcfaf5; font-weight: 700; font-size: 0.95rem; text-align: left; }
  .seasons-table tbody th { background: #fcfaf5; color: var(--forest, #173f35); font-family: Georgia, serif; font-size: 1.1rem; }
  .seasons-table tbody th small { display: block; color: var(--muted, #65706b); font-family: Georgia, serif; font-size: 0.78rem; margin-top: 4px; }

  .seasons-fact-list { display: grid; gap: 8px; margin: 0; padding: 0; }
  .seasons-fact-list div { display: grid; grid-template-columns: 88px 1fr; gap: 8px; }
  .seasons-fact-list dt { color: var(--muted, #65706b); font-size: 0.78rem; }
  .seasons-fact-list dd { color: var(--forest, #173f35); font-size: 0.9rem; font-weight: 600; margin: 0; line-height: 1.4; }

  .seasons-table ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .seasons-table ul li { padding: 4px 0; color: #394841; font-size: 0.86rem; line-height: 1.6; }

  .seasons-risks li { padding: 8px 0; border-bottom: 1px dashed rgba(23,63,53,.1); }
  .seasons-risks li:last-child { border-bottom: 0; }
  .seasons-risks strong { color: #b94c2c; display: block; font-size: 0.88rem; margin-bottom: 2px; }
  .seasons-risks span { color: #394841; font-size: 0.85rem; line-height: 1.55; }

  .seasons-suggested li { padding: 6px 0; border-bottom: 1px dashed rgba(23,63,53,.1); }
  .seasons-suggested li:last-child { border-bottom: 0; }
  .seasons-suggested strong { color: var(--forest, #173f35); display: block; font-size: 0.88rem; margin-bottom: 2px; }
  .seasons-suggested span { color: var(--muted, #65706b); font-size: 0.84rem; line-height: 1.55; }
  .seasons-foot-item { background: #fcf4e8; border-radius: 10px; padding: 8px 10px !important; }

  .seasons-note { margin-top: 22px; color: var(--muted, #65706b); font-size: 0.84rem; line-height: 1.85; }
  .seasons-note a { color: var(--wood-dark, #8b4f2a); font-weight: 700; border-bottom: 1px solid currentColor; }

  .eyebrow { color: var(--wood, #b96f3b); font-weight: 700; letter-spacing: 0.18em; font-size: 0.78rem; }
</style>
