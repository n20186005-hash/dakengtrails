---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  compact?: boolean;
}
const { eyebrow, title, description, image, imageAlt = '', compact = false } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero-compact': compact, 'page-hero-with-image': image }]}>
  <div class="shell page-hero-inner">
    <div class="page-hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p>{description}</p>
      <slot name="actions" />
    </div>
    {image && (
      <figure class="page-hero-image">
        <img src={image} alt={imageAlt} width="1800" height="1350" fetchpriority="high" />
      </figure>
    )}
  </div>
</section>
