---
import { attraction } from '../data/attraction';
---
<footer class="site-footer" aria-label="網站頁腳">
  <div class="shell footer-inner">
    <div class="footer-identity">
      <p>© 2026 {attraction.fullName} · 版權所有</p>
      <p>本網站是一個獨立的旅遊資訊項目。我們與任何政府機構或官方組織均無關聯。</p>
    </div>
    <nav class="footer-policies" aria-label="網站政策">
      <a href="/privacy-policy/">隱私政策</a>
      <a href="/terms-of-service/">服務條款</a>
      <a href="/cookie-settings/">Cookie 設定</a>
    </nav>
  </div>
</footer>
<style>
  .site-footer { background:#0e2a23; color:#d8e1dc; padding:28px 0; }
  .shell { max-width:1200px; margin:0 auto; padding:0 22px; }
  .footer-inner { display:flex; align-items:center; justify-content:space-between; gap:28px; }
  .footer-identity p { margin:4px 0; font-size:.85rem; line-height:1.75; }
  .footer-identity p + p { color:#b8c4be; font-size:.8rem; }
  .footer-policies { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:12px 22px; flex-shrink:0; }
  .footer-policies a { color:#e1e8e3; text-decoration:none; font-size:.85rem; }
  .footer-policies a:hover, .footer-policies a:focus-visible { color:#e8ae4f; text-decoration:underline; }
  @media(max-width:760px) { .footer-inner { flex-direction:column; align-items:flex-start; } .footer-policies { justify-content:flex-start; } }
</style>
