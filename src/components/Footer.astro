---
/**
 * 全域頁腳：包含全站導航、圖片版權宣告、評價來源與社群連結
 */
import { attraction, googleMapsLinks } from '../data/attraction';

const currentYear = new Date().getFullYear();

const links = {
  explore: [
    { label: '步道總覽', href: '/trails/' },
    { label: '步道比較', href: '/compare/' },
    { label: '情境路線', href: '/routes/' },
    { label: '行前準備', href: '/guides/' },
  ],
  plan: [
    { label: '即時氣象', href: '/weather/' },
    { label: '四季策略', href: '/seasons/' },
    { label: '行程節奏', href: '/itinerary/' },
    { label: '設施指南', href: '/facilities/' },
  ],
  reference: [
    { label: '歷史故事', href: '/history/' },
    { label: '資料來源', href: '/sources/' },
    { label: '編輯政策', href: '/editorial-policy/' },
    { label: '關於站點', href: '/about/' },
    { label: '隱私權', href: '/privacy/' },
  ],
};
---

<footer class="site-footer" aria-label="網站頁腳">
  <div class="shell">
    <section class="footer-top">
      <div class="footer-brand">
        <p class="eyebrow">{attraction.shortName.toUpperCase()}</p>
        <h2>{attraction.fullName}</h2>
        <p>城市近郊登山規劃指南，整合 14 條步道、停車、交通與 Google Maps 導航。</p>
        <p class="footer-address">{attraction.city}{attraction.district} · {attraction.fullName}{attraction.phone ? ` · ${attraction.phone}` : ''}</p>
      </div>
      <nav class="footer-nav">
        <div>
          <h3>探索與計畫</h3>
          <ul>
            {links.explore.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h3>科學與科普</h3>
          <ul>
            {links.plan.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h3>資料與聯絡</h3>
          <ul>
            {links.reference.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      </nav>
    </section>

    <section class="footer-source">
      <p class="eyebrow">SOURCES</p>
      <p>
        評分與精選評價為頁面顯示使用，<strong>同步自 Google 地圖使用者評價</strong>，同步時間 2026 年 9 月；版權歸原作者與 Google 地圖所有。
      </p>
      <p class="footer-source-link">
        <a href={googleMapsLinks.allReviews} target="_blank" rel="noopener noreferrer nofollow">
          在谷歌地圖查看全部評價
          <span aria-hidden="true">↗</span>
        </a>
      </p>
    </section>

    <section class="footer-copyright">
      <p>
        <strong>圖片版權聲明：</strong>本網站所展示的所有圖片產權及版權均歸原攝影者所有，授權詳見<a href="/sources/">圖片與資料來源</a>頁面。
      </p>
      <p class="footer-meta">© {currentYear} Dakeng Trails. 已標示原始檔及授權條款。任何爭議以開放原始授權約定為準。</p>
    </section>
  </div>
</footer>

<style>
  .site-footer {
    background: #0e2a23;
    color: #d8e1dc;
    padding: 80px 0 30px;
  }
  .shell { max-width: 1200px; margin: 0 auto; padding: 0 22px; }
  .footer-top { display: grid; grid-template-columns: 1.1fr 2fr; gap: 60px; padding-bottom: 40px; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .footer-brand h2 { font-family: Georgia, serif; font-size: 1.6rem; color: #fcfaf5; margin: 6px 0 14px; }
  .footer-brand p { color: #b8c4be; font-size: 0.92rem; line-height: 1.7; margin: 6px 0; max-width: 320px; }
  .footer-address { font-size: 0.84rem !important; color: #90a098 !important; }
  .footer-nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .footer-nav h3 { color: #fcfaf5; font-size: 0.96rem; margin: 0 0 14px; }
  .footer-nav ul { margin: 0; padding: 0; list-style: none; }
  .footer-nav li { padding: 6px 0; }
  .footer-nav a { color: #b8c4be; text-decoration: none; }
  .footer-nav a:hover { color: #e8ae4f; }
  .footer-source { padding: 28px 0 12px; }
  .footer-source .eyebrow { color: #e8ae4f; font-weight: 700; letter-spacing: 0.18em; font-size: 0.74rem; }
  .footer-source p { color: #b8c4be; font-size: 0.92rem; line-height: 1.7; max-width: 760px; }
  .footer-source-link a { color: #e8ae4f; text-decoration: none; border-bottom: 1px solid currentColor; }
  .footer-copyright { padding-top: 18px; border-top: 1px solid rgba(255,255,255,0.08); margin-top: 20px; }
  .footer-copyright p { color: #90a098; font-size: 0.82rem; line-height: 1.7; margin: 0 0 6px; }
  .footer-copyright a { color: #e8ae4f; text-decoration: none; }
  .footer-meta { color: #6f7c77 !important; font-size: 0.78rem !important; }

  @media (max-width: 980px) {
    .footer-top { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 660px) {
    .footer-nav { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
