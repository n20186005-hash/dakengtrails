{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dakengtrails",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_NAME": "Dakeng Trails",
    "SITE_URL": "https://dakengtrails.com"
  }
}
